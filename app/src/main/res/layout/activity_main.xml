<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/outerScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GhostLock S26"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/accent" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CVE-2026-43499 · Galaxy S26 family · temp root"
            android:textColor="@color/muted"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/card"
            android:padding="10dp"
            android:textColor="@color/warn"
            android:text="Use only on devices you own. Temp root vanishes on reboot. If an attempt already ran this boot, reboot before retrying."
            android:layout_marginBottom="12dp" />

        <!-- Device status (no actions here) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/card">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">
                <TextView
                    android:id="@+id/deviceInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="…"
                    android:textColor="#E5E7EB"
                    android:typeface="monospace"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/compatInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="…"
                    android:textStyle="bold"
                    android:layout_marginTop="6dp" />
                <TextView
                    android:id="@+id/shizukuStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Shizuku: unknown"
                    android:textColor="@color/muted"
                    android:textSize="12sp"
                    android:layout_marginTop="6dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- The one action -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/card">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRoot"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:text="Root my S26"
                    android:textSize="18sp" />
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchForce"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Force re-run without reboot (BOOT_FORCE=1, may crash)"
                    android:textColor="@color/muted"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/exploitStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Idle."
                    android:textStyle="bold"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Root command -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/card">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="command to run as root">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/cmdInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="id; getenforce"
                        android:typeface="monospace" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExec"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Run as root" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Log -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/log_bg">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Output"
                    android:textStyle="bold"
                    android:textColor="@color/accent" />
                <ScrollView
                    android:id="@+id/logScroll"
                    android:layout_width="match_parent"
                    android:layout_height="320dp"
                    android:layout_marginTop="6dp"
                    android:scrollbars="vertical"
                    android:fillViewport="true">
                    <TextView
                        android:id="@+id/logView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:typeface="monospace"
                        android:textSize="11sp"
                        android:textColor="#D1D5DB"
                        android:text="Ready.\n" />
                </ScrollView>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReset"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="Reset this boot's attempt (allows re-run without reboot — risky)" />

    </LinearLayout>
</ScrollView>
