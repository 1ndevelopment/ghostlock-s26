<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Query Shizuku manager so we can bind to it when installed. -->
    <queries>
        <package android:name="moe.shizuku.privileged.api" />
        <!-- Detect an existing KernelSU Manager install (package visibility). -->
        <package android:name="me.weishu.kernelsu" />
    </queries>

    <!-- Needed to check whether the su daemon socket is alive. Localhost
         only; no network traffic ever leaves the device. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Shizuku permission: lets Shizuku grant us the shell token. -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />
    <!-- PackageInstaller install of the bundled KernelSU Manager APK. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.GhostLock"
        android:extractNativeLibs="true"
        android:usesCleartextTraffic="false">

        <!-- Shizuku provider (required if you depend on shizuku-provider).
             ${applicationId} keeps it correct for both release and debug
             (debug adds ".debug" suffix) builds. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:exported="true"
            android:enabled="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Receives the PackageInstaller result for the KernelSU Manager
             install and reports it to the user. -->
        <receiver
            android:name=".InstallReceiver"
            android:exported="false" />
    </application>
</manifest>
